{
  "id": "./",
  "name": "ImgTools — Editor y optimizador de imágenes",
  "short_name": "ImgTools",
  "description": "Encuadre inteligente, Adaptación No Lineal (ANL), Modo BalBino y optimización local 100% privada de imágenes.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1a1a1a",
  "theme_color": "#4f46e5",
  "categories": ["photo", "utilities", "productivity"],
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "image",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/svg+xml",
            "image/avif",
            "image/gif",
            "image/bmp",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".svg",
            ".avif",
            ".gif",
            ".bmp"
          ]
        }
      ]
    }
  }
}
